# GENERATED FILE — do not edit by hand.
# Regenerate with `bun run config:sync` after changing packages/shared/src/config.ts.
#
# Copy to .env before running the stack. docker-compose.yml reads this file's variables,
# and packages/shared/src/env.ts validates them at process startup.
# Never commit the resulting .env file.

# --- Shared ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Local development stack (docker-compose only) ------------------------
# Throwaway local credentials, not secrets. Compose builds its own in-network URLs from these.
# Keep the major version in step with production.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=automend
POSTGRES_PASSWORD=automend
POSTGRES_DB=automend
POSTGRES_PORT=5432
REDIS_IMAGE=docker.dragonflydb.io/dragonflydb/dragonfly:v1.40.1
REDIS_PORT=6379

# --- Telemetry (api, worker, web) — OTLP logs to SigNoz -------------------
# Set OTEL_LOGS_ENABLED=false to run without a collector. Headers are only needed for a hosted backend.
OTEL_LOGS_ENABLED=true
# Collector base URL ("/v1/logs" is appended). Normally the deployed SigNoz.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317

# --- Postgres (api, worker, migrations) -----------------------------------
# Point both at a deployed database to run against it instead of the local compose one.
# Used by apps run on the host.
DATABASE_URL=postgres://automend:automend@localhost:5432/automend
# Used by apps inside the compose network, where localhost is the container itself.
DATABASE_URL_FROM_CONTAINER=postgres://automend:automend@postgres:5432/automend

# --- Redis (api, worker) --------------------------------------------------
# Automend runs DragonflyDB as its Redis server; it is wire-compatible, so this stays REDIS_URL.
REDIS_URL=redis://localhost:6379
REDIS_URL_FROM_CONTAINER=redis://redis:6379

# --- API ------------------------------------------------------------------
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Authentication (api) -------------------------------------------------
# AUTH_SECRET is required and has no default — the API refuses to start without it.
# At least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=
# The origin the browser uses. OAuth redirect URIs are built from it, so it must match what is registered with the provider.
AUTH_BASE_URL=http://localhost:5173
# Leave both blank to disable "Continue with Google". Redirect URI: http://localhost:5173/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Connectors (api) — services flows act through ------------------------
# SECRETS_KEY is required. Each provider pair is optional; both halves must be set for it to appear.
# Connecting a service is a SEPARATE OAuth registration from signing in with it, so each needs its
# own redirect URI. Google reuses GOOGLE_CLIENT_ID above and needs BOTH of these registered:
#   sign-in:   http://localhost:5173/api/v1/auth/callback/google
#   connector: http://localhost:5173/api/v1/auth/oauth2/callback/google-connector
# Envelope-encrypts stored connector tokens. Generate with: openssl rand -base64 32
SECRETS_KEY=
# Redirect URI: http://localhost:5173/api/v1/auth/oauth2/callback/slack-connector
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Redirect URI: http://localhost:5173/api/v1/auth/oauth2/callback/discord-connector
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Worker ---------------------------------------------------------------
WORKER_HEALTH_PORT=3002
WORKER_CONCURRENCY=5

# --- Web ------------------------------------------------------------------
# The production container only; the Vite dev server proxies /api itself.
WEB_PORT=8080
# Server-side proxy target. Never sent to the browser.
API_URL=http://localhost:3000
