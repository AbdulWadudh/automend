{
  "name": "@automend/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./logger": "./src/logger.ts",
    "./telemetry": "./src/telemetry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "config:sync": "bun run scripts/generate-env-example.ts",
    "config:check": "bun run scripts/generate-env-example.ts --check",
    "telemetry:verify": "bun --env-file=../../.env run scripts/verify-telemetry.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pino": "^10.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
