{
  "name": "@automend/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run src/migrate.ts",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio"
  },
  "dependencies": {
    "@automend/kits": "workspace:*",
    "@automend/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3"
  }
}
